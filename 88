class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int i = 0,j=0,k=0;
        int size = m+n;
        int[] temp = new int[size];
        while(i < m && j<n){
            if(nums1[i] < nums2[j]){
                temp[k] = nums1[i];
                i++;
            }else{ 
                temp[k] = nums2[j];
                j++;
            }k++;

        }

        while(i<m){
            temp[k] = nums1[i];
            k++;i++;
        }
        while(j<n){
            temp[k] = nums2[j];
                j++;k++;
        }

        //print back to original
        for(int x=0;x<size;x++){
            nums1[x] = temp[x];
        }
    }
}
