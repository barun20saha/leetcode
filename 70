class Solution {
    public int count(int i,int[] db,int n){
        if(i==n) return 1;
        if(i>n) return 0;
        if(db[i] != -1) return db[i];
        return db[i] = count(i+1,db,n)+count(i+2,db,n);
    }
    public int climbStairs(int n) {
       int[] db = new int[n+2];

       for(int i=0;i<n+2;i++){
        db[i] = -1;
       }

        return count(0,db,n);
    }
}
